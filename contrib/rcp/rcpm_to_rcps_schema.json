{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RCP Module to RCP Server",
    "type": "object",
    "properties": {
        "rcpm_version": {
            "type": "object",
            "properties": {
                "protocol": {
                    "type": "string",
                    "contentEncoding": "quoted-printable",
                    "maxLength": 255
                }
            },
            "required": [ "protocol" ],
            "additionalProperties": false
        },
        "rcpm_hello": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "contentEncoding": "quoted-printable",
                    "maxLength": 255
                },
                "cmd_descr": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "contentEncoding": "quoted-printable",
                                "maxLength": 255
                            },
                            "help": {
                                "type": "string",
                                "contentEncoding": "quoted-printable",
                                "maxLength": 512
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "contentEncoding": "quoted-printable",
                                            "maxLength": 255
                                        },
                                        "spec": {
                                            "type": "object",
                                            "properties": {
                                                "required" : {
                                                    "type": "boolean"
                                                },
                                                "help": {
                                                    "type": "string",
                                                    "contentEncoding": "quoted-printable",
                                                        "maxLength": 255
                                                },
                                                "action": {
                                                    "type": "string",
                                                    "contentEncoding": "quoted-printable",
                                                        "maxLength": 255
                                                },
                                                "pytype": {
                                                    "type": "string",
                                                    "contentEncoding": "quoted-printable",
                                                        "maxLength": 255
                                                },
                                                "default": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string",
                                                            "contentEncoding": "quoted-printable",
                                                                "maxLength": 255
                                                        },
                                                        {
                                                            "type": "integer"
                                                        }
                                                    ]
                                                }
                                            },
                                            "required": [ "help" ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [ "name", "spec" ],
                                    "additionalProperties": false
                                }
                            },
                            "get_keys": {
                                "type": "object",
                                "properties": {
                                    "uicc" : {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "contentEncoding": "quoted-printable",
                                                "maxLength": 255
                                        },
                                        "maxItems": 255
                                    },
                                    "euicc" : {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "contentEncoding": "quoted-printable",
                                                "maxLength": 255
                                        },
                                        "maxItems": 255
                                    }
                                },
                                "oneOf": [
                                    { "required": [ "uicc" ] },
                                    { "required": [ "euicc" ] }
                                ],
                                "additionalProperties": false
                            }
                        },
                        "required": [ "name",  "help", "args" ],
                        "additionalProperties": false
                    }
                },
                "suitable_for": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "atr": {
                                "type": "string",
                                "pattern": "^[0-9A-F]{0,66}$"
                            }
                        },
                        "oneOf": [
                            { "required": [ "atr" ] }
                        ],
                        "additionalProperties": false
                    }
                },
                "addr": {
                    "type": "string",
                    "contentEncoding": "quoted-printable",
                    "maxLength": 255
                },
                "port": {
                    "type": "integer"
                }
            },
            "required": [ "name",  "cmd_descr", "suitable_for", "addr", "port" ],
            "additionalProperties": false
        }
    },
    "oneOf": [
        { "required": [ "rcpm_hello" ] },
        { "required": [ "rcpm_version" ] }
    ],
    "additionalProperties": false
}
